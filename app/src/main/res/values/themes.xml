<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The dark ground behind everything, so nothing flashes white before Compose draws. -->
    <style name="Theme.PSSoundboard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>

    <!-- Launch screen: the Spew mouth on the dark ground, then the app theme. -->
    <style name="Theme.PSSoundboard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PSSoundboard</item>
    </style>
</resources>
